# The interviewer reads the nearest .env at or above its own folder, so the
# repo-root .env shared with the screening app already covers the Azure keys.
# Copy this to .env only if you want interviewer-specific overrides.
# Never commit the real .env.

AZURE_OPENAI_ENDPOINT="https://<your-resource>.openai.azure.com/"
AZURE_OPENAI_API_KEY="<your-key>"
AZURE_OPENAI_API_VERSION="2025-04-01-preview"
AZURE_OPENAI_DEPLOYMENT="<your-deployment-name>"

# --- who the candidate meets --------------------------------------------------
INTERVIEWER_NAME="Alex"
INTERVIEWER_ROLE="Technical Interviewer"
COMPANY_NAME="AP Technologies Pvt Ltd"

# --- interview shape ----------------------------------------------------------
PLANNED_QUESTION_COUNT=10       # prepared questions, before live follow-ups
MAX_FOLLOWUPS_PER_QUESTION=2    # how hard to dig into one answer
MAX_TOTAL_TURNS=30              # hard cap on the whole conversation
MIN_ANSWER_WORDS_FOR_FOLLOWUP=12

# --- evaluation weights (normalised to 100) -----------------------------------
WEIGHT_COMMUNICATION=15
WEIGHT_TECHNICAL=20
WEIGHT_DOMAIN=15
WEIGHT_PROJECTS=15
WEIGHT_JD_ALIGNMENT=10
WEIGHT_PROBLEM_SOLVING=15
WEIGHT_ANSWER_QUALITY=10

# Verdict bands on the overall interview score.
BAND_STRONG=80
BAND_HIRE=65
BAND_BORDERLINE=50

# How much the closing holistic review counts against the mean of the per-answer
# grades. 0.5 gives them an equal say; 0 uses only the per-answer grades.
HOLISTIC_BLEND=0.5

# --- screening hand-off -------------------------------------------------------
# Only needed if the screening app's data folder is somewhere unusual. By default
# ../Candidate screening/data and .../backend/data are both searched.
# SCREENING_DATA_DIR="D:/path/to/Candidate screening/data"

# --- server -------------------------------------------------------------------
PORT=8010

# --- interview links ----------------------------------------------------------
# Each drafted invitation carries a signed link that starts that one candidate's
# interview in the Virtual AI Interviewer. Both apps read these from the same
# repo-root .env and MUST agree on the secret.
#
# Where the interviewer is reachable FROM THE CANDIDATE'S BROWSER. The default is
# only useful for a demo on this machine - a real candidate cannot open
# 127.0.0.1. Set this to the host the interviewer is actually served on.
INTERVIEW_BASE_URL="http://127.0.0.1:8010"
#
# Signing key for the links. If unset, both apps derive one from
# AZURE_OPENAI_API_KEY, so links work with no configuration - but rotating that
# Azure key would then invalidate every link already sent. Set an explicit
# secret before you send links to real people.
# INTERVIEW_LINK_SECRET="<a long random string>"
#
INTERVIEW_LINK_TTL_DAYS=14
