# Copy to .env and fill in. Never commit the real .env.
AZURE_OPENAI_ENDPOINT="https://<your-resource>.openai.azure.com/"
AZURE_OPENAI_API_KEY="<your-key>"
AZURE_OPENAI_API_VERSION="2025-04-01-preview"
AZURE_OPENAI_DEPLOYMENT="<your-deployment-name>"

# --- screening defaults (optional) ---
SHORTLIST_THRESHOLD=60
WEIGHT_EDUCATION=15
WEIGHT_SKILLS=35
WEIGHT_EXPERIENCE=25
WEIGHT_PROJECTS=15
WEIGHT_CERTIFICATIONS=10
CUTOFF_SKILLS=40
MAX_CONCURRENT_AI_CALLS=6

# --- upload limits (optional) --------------------------------------------------
# Everything is processed in memory; these caps bound the worst case (a huge
# batch or a ZIP bomb). Oversize files become error rows, not a dead batch.
MAX_UPLOAD_FILES=500
MAX_FILE_MB=20
MAX_TOTAL_UPLOAD_MB=300
MAX_ZIP_ENTRIES=1000

# --- access control (optional) -------------------------------------------------
# Off when unset. When set, every /api/* request must carry this token
# (X-Access-Token header or ?token=). The UI prompts for it on first use.
# Set it BEFORE exposing the app beyond localhost - the API serves candidate PII.
# APP_ACCESS_TOKEN="<a long random string>"

# --- interview outreach (optional) -------------------------------------------
# Identity used in the drafted invitation. Nothing is ever transmitted:
# there is no SMTP client in this project - "send" is simulated.
COMPANY_NAME="AP Technologies Pvt Ltd"
RECRUITER_NAME="Talent Acquisition Team"
RECRUITER_EMAIL="talent@example.com"

# --- interview links ----------------------------------------------------------
# Each drafted invitation carries a signed link that starts that one candidate's
# interview in the Virtual AI Interviewer. Both apps read these from the same
# repo-root .env and MUST agree on the secret.
#
# Where the interviewer is reachable FROM THE CANDIDATE'S BROWSER. The default is
# only useful for a demo on this machine - a real candidate cannot open
# 127.0.0.1. Set this to the host the interviewer is actually served on.
INTERVIEW_BASE_URL="http://127.0.0.1:8010"
#
# Signing key for the links. If unset, both apps derive one from
# AZURE_OPENAI_API_KEY, so links work with no configuration - but rotating that
# Azure key would then invalidate every link already sent. Set an explicit
# secret before you send links to real people.
# INTERVIEW_LINK_SECRET="<a long random string>"
#
INTERVIEW_LINK_TTL_DAYS=14

# Set to 0 to go back to invitations that promise a follow-up instead of
# carrying an interview link.
INCLUDE_INTERVIEW_LINK=1
